# Master Plan IA 2025 - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ====================
# ENVIRONMENT SETTINGS
# ====================
ENVIRONMENT=development  # development, staging, production
DEBUG=false  # Set to true only in development
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ====================
# SECURITY KEYS
# ====================
# Generate secure keys with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=  # Required for JWT authentication
ENCRYPTION_KEY=  # Required for encrypting sensitive data

# ====================
# DATABASE
# ====================
DATABASE_URL=  # PostgreSQL connection string
DATABASE_PASSWORD=  # Database password (if not included in URL)

# ====================
# SUPABASE
# ====================
SUPABASE_URL=  # Your Supabase project URL
SUPABASE_ANON_KEY=  # Your Supabase anonymous key
SUPABASE_SERVICE_ROLE_KEY=  # Optional: for admin operations

# ====================
# REDIS CACHE
# ====================
REDIS_URL=redis://localhost:6379/0  # Redis connection URL

# ====================
# EXTERNAL SERVICES
# ====================
ANTHROPIC_API_KEY=  # For Claude AI integration
OPENAI_API_KEY=  # For OpenAI integration
GROQ_API_KEY=  # For Groq integration
REPLICATE_API_KEY=  # For Replicate integration

# ====================
# NETWORKING
# ====================
HOST=127.0.0.1  # API host
PORT=8000  # API port
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated list

# ====================
# RATE LIMITING
# ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ====================
# MONITORING
# ====================
SENTRY_DSN=  # Optional: Sentry error tracking
METRICS_ENABLED=true
TELEMETRY_ENABLED=false

# ====================
# AWS (Optional)
# ====================
AWS_ACCESS_KEY_ID=  # For S3 backups
AWS_SECRET_ACCESS_KEY=  # For S3 backups
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=  # S3 bucket for backups

# ====================
# NOTIFICATIONS (Optional)
# ====================
SMTP_HOST=  # Email server
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@masterplan-ia.com

SLACK_WEBHOOK_URL=  # For Slack notifications
DISCORD_WEBHOOK_URL=  # For Discord notifications

# ====================
# VOICE DETECTION
# ====================
VOSK_MODEL_PATH=models/vosk-model-small-fr-0.22
VOICE_SAMPLE_RATE=16000
VOICE_LANGUAGE=fr-FR

# ====================
# SECURITY HEADERS
# ====================
HTTPS_REDIRECT_ENABLED=false  # Set to true in production
SECURITY_HEADERS_ENABLED=true